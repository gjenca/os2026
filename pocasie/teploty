#!/bin/bash

curl --silent 'https://www.shmu.sk/sk/?page=59' |
    tr -d '\n' | tr '<' '\n' |
    grep '^td ' | grep -E 'stanica|teplota' |
    while read VAR
    do
        if echo "$VAR" | grep stanica > /dev/null
        then
            STANICA=$(echo "$VAR" | sed 's/.*>//')
        else
            TEPLOTA=$(echo "$VAR" | 
                sed 's/.*>\([^ ]*\) .*/\1/')
            echo "$STANICA:$TEPLOTA"
        fi
    done    

#!/bin/bash


TITLE='Gallery'
RESIZE='20'
while true
do
    if [ "$1" = -t ] ; then # ; == newline
        TITLE="$2"
        shift 2
    elif [ "$1" = -p ] ; then
        RESIZE="$2"
        shift 2
    else
        break
    fi
done

cat <<THE_END
<html>
<head>
<title>$TITLE</title>
</head>
<body>
<h1>
$TITLE
</h1>
<table>
THE_END

if test ! -d mini
then
    mkdir mini
fi

while [ "$#" != 0 ]
do
    MINIATURA='mini/'$(echo "$1" | sed 's/jpg$/png/')
    convert -resize "$RESIZE%" "$1" "$MINIATURA" 2>/dev/null
    echo '<tr>'
    echo '<td>'
    echo '<a href="'"$1"'">'
    echo '<img src="'$MINIATURA'">'
    echo '</a>'
    echo '</td>'
    echo '</tr>'
    shift
done

cat <<THE_END
</table>
</body>
</html>
THE_END
